# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Environment / secrets
# `.env.*` as well as `.env`, so a .env.local or .env.production cannot be
# committed by accident; .env.example is the one deliberate exception.
.env
.env.*
!.env.example

# Local JSON data store (runtime state, not source)
data/
*.local.json

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/

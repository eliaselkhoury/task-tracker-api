# Copy this file to .env and adjust as needed. Never commit .env itself.

# Where the JSON task store lives. A relative value is resolved against the
# process working directory, not against the project root - so this default is
# only correct when you start the server from the repo root (which is what the
# README tells you to do, and what WORKDIR /app gives you in the container).
# Use an absolute path if you need to start it from anywhere else.
DATA_FILE=data/tasks.json

# Comma-separated list of origins allowed to call the API from a browser.
# The default matches the VS Code Live Server port used in the course videos.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
